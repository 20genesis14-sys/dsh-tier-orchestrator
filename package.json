{
  "name": "dsh-tier-router",
  "version": "0.4.8",
  "type": "module",
  "description": "Tiered model routing for DeepSeek Harness: a strong tier for planning/architecture/review, a cheap tier for implementation, with plan-mode-aware auto routing, advisor/review consultations, a high-impact escalation guard, failure auto-escalation, durable tier configuration, and subagent tiering.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-routing",
    "tiered-routing",
    "advisor"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "agent-presets",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "node --check lib/index.js && node --check lib/pure.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
