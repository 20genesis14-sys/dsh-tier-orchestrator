{
  "name": "dsh-tier-router",
  "version": "0.7.1",
  "type": "module",
  "description": "Tiered model routing for DeepSeek Harness (>= 0.2): a strong tier for planning/architecture/review, a cheap tier for implementation, plan-mode-aware auto routing on the agent/request seam, per-tier model fallback chains, task-intensity reasoning effort, advisor/review consultations, a high-impact escalation guard, failure auto-escalation, durable host-entry configuration, and subagent tiering.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-routing",
    "tiered-routing",
    "advisor"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "AGENTS.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "node scripts/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
